# Database Configuration
POSTGRES_PASSWORD=downloadarr_secure_password

# VPN Configuration
VPN_ENABLED=false
VPN_CONFIG_PATH=/app/vpn/config.ovpn

# FlareSolverr Configuration
# FlareSolverr helps bypass Cloudflare protection for torrent indexers
# No additional configuration needed - it runs automatically on port 8191

# Aria2 Configuration
ARIA2_SECRET=downloadarr_aria2_secret

# Timezone
TZ=UTC

# Download Configuration
DOWNLOAD_PATH=./downloads
LIBRARY_PATH=./library

# Redis Configuration (usually defaults are fine)
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
NODE_ENV=production
PORT=3001

# Application Version
# Set this to a specific version tag (e.g., v1.0.0) or leave as 'latest'
# This determines which Docker images to pull and helps with update detection
APP_VERSION=latest

# CORS Configuration
# Set the allowed frontend origin(s) for CORS requests
# Single origin: http://localhost:3000
# Multiple origins (comma-separated): http://localhost:3000,https://your-domain.com,http://downloadarr:3000
# For Docker deployments, you may need: http://downloadarr:3000
# For local development: http://localhost:3000
# For external access: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Optional extra origins allowed to call the API, comma-separated, e.g. a LAN
# address or a reverse proxy: http://192.168.1.10:3000,https://media.example.com
# Use * to allow any origin (only on a trusted network).
CORS_ORIGINS=

# Frontend Configuration
# API URL for the frontend to connect to the backend
# For Docker deployments: /api (uses nginx proxy)
# For local development: http://localhost:3001
# For external API access: http://your-api-server:3001
VITE_API_URL=http://localhost:3001/api

# LAN discovery
# Answers "who is Downloadarr?" UDP broadcasts on port 7360 so TV apps can find the API
# without typing an address. Requires 7360/udp to be published (it is in docker-compose.yml).
LAN_DISCOVERY_ENABLED=true
# Optional: advertise a full API URL instead of letting clients use the address the reply came from
# (e.g. behind a reverse proxy). Example: https://downloadarr.example.com/api
LAN_DISCOVERY_ADVERTISED_URL=

# External API Keys for Discovery Services
# These are now configured through the application's onboarding process or settings page
# No need to set them as environment variables
