# Database Configuration
POSTGRES_PASSWORD=downloadarr_secure_password

# VPN Configuration
VPN_ENABLED=false
VPN_CONFIG_PATH=/app/vpn/config.ovpn

# FlareSolverr Configuration
# FlareSolverr helps bypass Cloudflare protection for torrent indexers
# No additional configuration needed - it runs automatically on port 8191

# Aria2 Configuration
ARIA2_SECRET=downloadarr_aria2_secret

# Where aria2 sees the download folder. In Docker Compose aria2 is a container of
# its own with the folder at /downloads, which is the default.
# ARIA2_DOWNLOAD_PATH=/downloads

# Timezone
TZ=UTC

# Download Configuration
DOWNLOAD_PATH=./downloads
LIBRARY_PATH=./library

# Redis Configuration (usually defaults are fine)
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
NODE_ENV=production
PORT=3001

# Application Version
# Set this to a specific version tag (e.g., v1.0.0) or leave as 'latest'
# This determines which Docker images to pull and helps with update detection
APP_VERSION=latest

# CORS Configuration
# The web UI is served from the same address as the API and needs none.
# These are other origins allowed to call the API from a browser, comma-separated,
# e.g. another app on your network: http://192.168.1.10:8081,https://tv.example.com
# Use * to allow any origin (only on a trusted network).
CORS_ORIGINS=

# LAN discovery
# Answers "who is Downloadarr?" UDP broadcasts on port 7360 so TV apps can find Downloadarr
# without typing an address. Requires 7360/udp to be published (it is in docker-compose.yml).
LAN_DISCOVERY_ENABLED=true
# Optional: advertise a full address instead of letting clients use the address the reply came from
# (e.g. behind a reverse proxy). Example: https://downloadarr.example.com
LAN_DISCOVERY_ADVERTISED_URL=

# External API Keys for Discovery Services
# These are now configured through the application's onboarding process or settings page
# No need to set them as environment variables
